{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BigPocket",
  "version": "1.4.2",
  "identifier": "com.ygt.bigpocket",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [

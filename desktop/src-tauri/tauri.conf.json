{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BigPocket",
  "version": "1.5.0",
  "identifier": "com.ygt.bigpocket",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "BigPocket — Kontrol Paneli",
        "width": 1240,
        "height": 800,
        "resizable": true,
        "center": true,
        "url": "http://127.0.0.1:8085"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
